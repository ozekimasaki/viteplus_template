{
  "name": "vite-template",
  "version": "1.0.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "check": "vp check",
    "test": "vp test",
    "build:dist": "vp build && node scripts/format-build-html.mjs",
    "build": "vp run build:dist",
    "preview": "vp preview",
    "lint": "vp lint",
    "format:templates": "vp exec prettier --plugin=@prettier/plugin-pug --write \"src/**/*.pug\" \"README.MD\" \"*.{md,mdc}\"",
    "format:templates:check": "vp exec prettier --plugin=@prettier/plugin-pug --check \"src/**/*.pug\" \"README.MD\" \"*.{md,mdc}\"",
    "format": "vp run format:templates",
    "format:check": "vp run format:templates:check",
    "prepare": "vp config"
  },
  "dependencies": {
    "@splidejs/splide": "^4.1.4",
    "gsap": "^3.13.0"
  },
  "devDependencies": {
    "@prettier/plugin-pug": "^3.4.2",
    "@types/node": "^25.5.0",
    "autoprefixer": "^10.4.19",
    "glob": "^13.0.6",
    "prettier": "^3.4.2",
    "sass": "^1.98.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.1.11",
    "vite-plugin-glob-input": "^0.3.0",
    "vite-plugin-image-sizes": "^1.1.2",
    "vite-plugin-sass-glob-import": "^6.0.0",
    "vite-plus": "0.1.11",
    "vite-pug-static-builder": "^1.1.5"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.1.11",
    "vitest": "npm:@voidzero-dev/vite-plus-test@0.1.11"
  },
  "browserslist": [
    "defaults"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "npm@11.11.1"
}
