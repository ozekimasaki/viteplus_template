-
  var default_language = "ja";
  var default_title = "タイトル";
  var default_url = "https://example.com/";
  var default_site_name = "サイト名";
  var default_description = "ディスクリプション";
  var default_og_image = "https://example.com/assets/img/ogp.jpg";
  var default_type = "website";
  var default_locale = "ja_JP";
  var page_name = "";
block vars

include ./_partials/_meta.pug

doctype html
html(lang=meta_language || default_language)
  head
    +site-meta
    include ./_partials/_head-js.pug
    include ./_partials/_head-css.pug
    include ./_partials/_head-analytics.pug
    include ./_partials/_head-font.pug
    block head
  body
    block outside
    include ./_partials/_header.pug
    main.main-wrapper(class=page_name ? `main-wrapper--${page_name}` : undefined)
      block contents
    include ./_partials/_footer.pug
    block foot
